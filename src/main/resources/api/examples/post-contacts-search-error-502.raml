#%RAML 1.0 NamedExample
value:
  response:
    sourceSystemRefId: "<<unique Id from source system>>"
    sourceSystemName: "CCA"
    sourceSystemVersion: "1.0"
    transactionId: "<<Mulesoft Correlation ID>>"
    outcome:
      resultCode: "200"
      resultDescription: "Bad Gateway"
    errorDetails:
      errorDetail:
        errorCode: "502"
        errorDescription: "Downstream system unavailable or returned an invalid response"
