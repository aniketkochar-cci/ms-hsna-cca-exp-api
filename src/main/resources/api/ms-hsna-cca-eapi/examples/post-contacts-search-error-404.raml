#%RAML 1.0 NamedExample
value:
  response:
    sourceSystemRefId: "<<unique Id from source system>>"
    sourceSystemName: "CCA"
    sourceSystemVersion: "1.0"
    transactionId: "<<Mulesoft Correlation ID>>"
    outcome:
      resultCode: "200"
      resultDescription: "No account found"
    errorDetails:
      errorDetail:
        errorCode: "404"
        errorDescription: "No contact or address found for the supplied contactId and accountAddressId"