#%RAML 1.0 DataType
type: object
description: Response envelope for success, no match and error
properties:
  response:
    type: object
    properties:
      sourceSystemRefId:
        type: string
        description: Echo of request value
      sourceSystemName:
        type: string
        description: Echo of request value
      sourceSystemVersion:
        type: string
        description: Echo of request value
      transactionId:
        type: string
        description: MuleSoft correlation ID generated by the platform (same value as X-Correlation-ID)
      outcome:
        type: object
        properties:
          resultCode:
            type: string
            description: 100 = Success.
          resultDescription:
            type: string
            description: Text description of the result
      getContactResponse:
        type: object
        required: false
        description: Present on success only. Not returned on error or no match.
        properties:
          contactCollection:
            type: array
            minItems: 0
            maxItems: 1
            description: Matching contacts (empty array when none). 0 or 1 element for contract search.
            items:
              type: object
              properties:
                contactId:
                  type: string
                  description: CCA contact identifier
                accountId:
                  type: string
                  required: false
                  description: CCA account identifier (mapped to Contact.AccountId)
                customerRef:
                  type: string
                  required: false
                  description: Customer reference. New field added at contact level
                title:
                  type: string
                  required: false
                  description: Salutation
                firstName:
                  type: string
                lastName:
                  type: string
                suffix:
                  type: string
                email:
                  type: string
                mobilePhone:
                  type: string
                homePhone:
                  type: string
                workPhone:
                  type: string
                workPhoneExtn:
                  type: string
                status:
                  type: string
                  required: false
                  description: Contact status [values TBC]
                identityManager:
                  type: string
                  required: false
                  description: Identity provider
                identityUniqueId:
                  type: string
                  required: false
                  description: Unique ID at the identity provider
                paperless:
                  type: string
                  enum: ["true", "false"]
                  description: Paperless preference as a string
                paperlessStatus:
                  type: string
                  description: Paperless status [values TBC]. May be blank
                customerType:
                  type: string
                  required: false
                  description: Customer type [values TBC]
                noEmail:
                  type: boolean
                  required: false
                  description: Opted out of email
                noMail:
                  type: boolean
                  required: false
                  description: Opted out of postal mail
                noShare:
                  type: boolean
                  required: false
                  description: Opted out of data sharing
                noTeleSales:
                  type: boolean
                  required: false
                  description: Opted out of telesales
                advocateId:
                  type: string
                  required: false
                  description: Advocate / referrer ID
                totalReferralsMade:
                  type: integer
                  required: false
                  description: Number of referrals made
                contactSFID:
                  type: string
                  required: false
                  maxLength: 18
                  description: Salesforce contact Id
                smsMarketing:
                  type: string
                  required: false
                  description: SMS marketing status, e.g. OptedIn
                smsMarketingSubStatus:
                  type: string
                  required: false
                smsMarketingSource:
                  type: string
                  required: false
                emailMarketingSource:
                  type: string
                  required: false
                experianConfidenceMobile:
                  type: string
                  required: false
                  description: Experian confidence for mobile, e.g. HIGH
                experianCheckDateMobile:
                  type: datetime
                  format: rfc3339
                  required: false
                  description: Date of the Experian mobile check (ISO 8601)
                verifiedUSAAMemberID:
                  type: string
                  required: false
                unverifiedUSAAMemberID:
                  type: string
                  required: false
                addressCollection:
                  type: array
                  description: Addresses of the contact (Service, Mailing)
                  items:
                    type: object
                    properties:
                      addressType:
                        type: string
                        enum: [Service, Mailing]
                      customerRef:
                        type: string
                      accountAddressId:
                        type: string
                        description: CCA address identifier (mapped to premise)
                      houseNo:
                        type: string
                      addressLine1:
                        type: string
                      addressLine2:
                        type: string
                        description: May be blank
                      city:
                        type: string
                      state:
                        type: string
                        description: State code
                      zipcode:
                        type: string
                      country:
                        type: string
                      locationType:
                        type: string
                        required: false
                      taxExempt:
                        type: boolean
                        required: false
                      authUser:
                        type: string
                        required: false
                        description: Authorised user
                      masterFlag:
                        type: boolean
                        description: Master address flag
                      noOfContracts:
                        type: integer
                        description: Number of contracts at the address