#%RAML 1.0 DataType
type: object
properties:
  response:
    type: object
    properties:
      sourceSystemRefId:
        type: string
        example: <<unique Id from source system>>
        description: Echo of request value
      sourceSystemName:
        type: string
        example: CCA
        description: Echo of request value
      sourceSystemVersion:
        type: string
        example: '1.0'
        description: Echo of request value
      transactionId:
        type: string
        example: <<Mulesoft Correlation ID>>
        description: MuleSoft correlation ID generated by the platform (same value as X-Correlation-ID)
      outcome:
        type: object
        properties:
          resultCode:
            type: string
            example: '100'
            description: 100 = Success. For any non-success response it is 200 and the actual error is in errorDetails.errorDetail.errorCode
          resultDescription:
            type: string
            example: Success
            description: Text description of the result
      getContactResponse:
        type: object
        required: false
        description: Returned on success only. Not returned on error or no match.
        properties:
          contactCollection:
            type: array
            description: Matching contacts (all matches, no disambiguation)
            items:
              type: object
              properties:
                contactId:
                  type: string
                  example: '13829902'
                  description: CCA contact identifier
                accountId:
                  type: string
                  example: '13793371'
                  description: CCA account identifier (mapped to Contact.AccountId)
                  required: false
                customerRef:
                  type: string
                  example: '141711622'
                  description: Customer reference
                  required: false
                title:
                  type: string
                  example: ''
                  description: Salutation
                  required: false
                firstName:
                  type: string
                  example: 'Brian'
                  description: First name
                lastName:
                  type: string
                  example: 'Fink'
                  description: Last name
                suffix:
                  type: string
                  example: ''
                  description: Name suffix
                  required: false
                email:
                  type: string
                  example: 'fink1705@gmail.com'
                  description: Email address
                mobilePhone:
                  type: string
                  example: '9202316417'
                  description: Mobile phone
                homePhone:
                  type: string
                  example: ''
                  description: Home phone
                workPhone:
                  type: string
                  example: ''
                  description: Work phone
                  required: false
                workPhoneExtn:
                  type: string
                  example: ''
                  description: Work phone extension
                  required: false
                status:
                  type: string
                  example: ''
                  description: Contact status
                  required: false
                identityManager:
                  type: string
                  example: ''
                  description: Identity provider
                  required: false
                identityUniqueId:
                  type: string
                  example: ''
                  description: Unique ID at the identity provider
                  required: false
                paperless:
                  type: string
                  example: 'true'
                  description: Paperless preference as a string - true / false
                paperlessStatus:
                  type: string
                  example: ''
                  description: Paperless status
                customerType:
                  type: string
                  example: ''
                  description: Customer type
                  required: false
                noEmail:
                  type: boolean
                  example: false
                  description: Opted out of email
                  required: false
                noMail:
                  type: boolean
                  example: false
                  description: Opted out of postal mail
                  required: false
                noShare:
                  type: boolean
                  example: false
                  description: Opted out of data sharing
                  required: false
                noTeleSales:
                  type: boolean
                  example: false
                  description: Opted out of telesales
                  required: false
                advocateId:
                  type: string
                  example: 'H124124'
                  description: Advocate / referrer ID
                  required: false
                totalReferralsMade:
                  type: integer
                  example: 1
                  description: Number of referrals made
                  required: false
                contactSFID:
                  type: string
                  example: '1'
                  description: Salesforce contact Id (18 characters)
                  required: false
                smsMarketing:
                  type: string
                  example: 'OptedIn'
                  description: SMS marketing status, e.g. OptedIn
                  required: false
                smsMarketingSubStatus:
                  type: string
                  example: 'Complete'
                  description: SMS marketing sub-status
                  required: false
                smsMarketingSource:
                  type: string
                  example: 'WEB-Sale'
                  description: Source of SMS opt-in
                  required: false
                emailMarketingSource:
                  type: string
                  example: 'WEB-Sale'
                  description: Source of email opt-in
                  required: false
                experianConfidenceMobile:
                  type: string
                  example: 'HIGH'
                  description: Experian confidence for mobile, e.g. HIGH
                  required: false
                experianCheckDateMobile:
                  type: datetime
                  format: rfc3339
                  example: '2026-05-14T14:22:54Z'
                  description: Date of the Experian mobile check (ISO 8601)
                  required: false
                verifiedUSAAMemberID:
                  type: string
                  example: '4598437598'
                  description: Verified USAA member ID
                  required: false
                unverifiedUSAAMemberID:
                  type: string
                  example: '4598437598'
                  description: Unverified USAA member ID
                  required: false
                addressCollection:
                  type: array
                  description: Addresses of the contact (Service, Mailing)
                  items:
                    type: object
                    properties:
                        addressType:
                          type: string
                          example: 'Service'
                          description: Service or Mailing
                        customerRef:
                          type: string
                          example: '141711622'
                          description: Customer reference
                        accountAddressId:
                          type: string
                          example: '14746846'
                          description: CCA address identifier (mapped to premise)
                        houseNo:
                          type: string
                          example: '1746'
                          description: House number
                        addressLine1:
                          type: string
                          example: '1746 Addie Pkwy'
                          description: Street address line 1
                        addressLine2:
                          type: string
                          example: ''
                          description: Address line 2
                        city:
                          type: string
                          example: 'Oshkosh'
                          description: City
                        state:
                          type: string
                          example: 'WI'
                          description: State code
                        zipcode:
                          type: string
                          example: '54904'
                          description: ZIP code
                        country:
                          type: string
                          example: 'USA'
                          description: Country
                        locationType:
                          type: string
                          example: 'RESIDENTIAL'
                          description: Location type, e.g. RESIDENTIAL
                          required: false
                        taxExempt:
                          type: boolean
                          example: false
                          description: Tax exempt flag
                          required: false
                        authUser:
                          type: string
                          example: ''
                          description: Authorised user
                          required: false
                        masterFlag:
                          type: boolean
                          example: false
                          description: Master address flag
                        noOfContracts:
                          type: integer
                          example: 0
                          description: Number of contracts at the address
      errorDetails:
        type: object
        required: false
        description: Returned only on non-success responses (no match, bad request, bad gateway)
        properties:
          errorDetail:
            type: object
            properties:
              errorCode:
                type: string
                example: '404'
                description: Actual error code - 404 no match, 400 bad request, 502 bad gateway
              errorDescription:
                type: string
                example: No contact found for the supplied search criteria
                description: Error description. PAPI messages are never exposed